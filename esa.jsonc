// 阿里云 ESA 边缘安全加速部署配置
// 字段说明：
//   install.command   依赖安装命令（Corepack 启用 pnpm）
//   build.command     构建命令（生成 dist 目录）
//   publish.directory 构建后静态资源输出目录（纯静态站点 = dist）
//   assets.directory  同上，部分版本的 ESA 走这个字段读取资源
//   functions.enabled 是否使用边缘函数（纯静态博客关闭）
{
  "install": {
    "command": "corepack enable && pnpm install"
  },
  "build": {
    "command": "corepack enable && pnpm run build"
  },
  "publish": {
    "directory": "dist"
  },
  "assets": {
    "directory": "dist"
  },
  "functions": {
    "enabled": false
  }
}
