---
import Icon from './Icon.astro';
import { site } from '../lib/posts';

const year = new Date().getFullYear();

const channels = [
  { name: 'RSS', icon: 'rss', href: '/rss.xml' },
];

const groups = [
  { name: '微信交流群', icon: 'wechat', href: '' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__id">
      <img
        src="/avatars/avatar.png"
        alt={site.author}
        class="site-footer__avatar"
        width="40"
        height="40"
      />
      <div class="site-footer__id-text">
        <strong>{site.author}</strong>
        <span>AI · Code · Web</span>
      </div>
    </div>

    <nav class="site-footer__links" aria-label="页脚链接">
      {channels.map(({ name, icon, href }) => (
        <a
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <Icon name={icon} size={15} />
          {name}
        </a>
      ))}
      <span class="site-footer__sep" aria-hidden="true"></span>
      {groups.map(({ name, icon, href }) => (
        href ? (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <Icon name={icon} size={15} />
            {name}
          </a>
        ) : (
          <span class="site-footer__item">
            <Icon name={icon} size={15} />
            {name}
          </span>
        )
      ))}
    </nav>
  </div>

  <div class="site-footer__bar">
    <span>© {year} {site.author}</span>
    <span aria-hidden="true">·</span>
    <a href={site.url}>{site.url.replace('https://', '')}</a>
    <span aria-hidden="true">·</span>
    <span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer nofollow">粤ICP备2026121562号-2</a></span>
  </div>
</footer>
