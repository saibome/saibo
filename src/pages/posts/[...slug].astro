---
// Old URLs: /posts/<folder>/<name>  →  new URLs: /<slug>
// This page keeps old links working by emitting a per-post static redirect
// page (meta-refresh 0s + canonical) — compatible with pure static hosting
// (nginx / caddy file_server) without relying on platform redirect files.
//
// Deleted posts that still need old-URL coverage are fed from
// DELETED_POST_REDIRECTS in posts.ts; for these we emit the same meta-refresh
// wrapper pointing at the configured destination (typically `/`).

import { getCollection } from 'astro:content';
import {
  DELETED_POST_REDIRECTS,
  getPostPath,
  sortPosts,
} from '../../lib/posts';

type RedirectEntry =
  | { kind: 'active'; slug: string; title: string; dest: string }
  | { kind: 'deleted'; slug: string; title: string; dest: string };

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));

  const active: RedirectEntry[] = posts.map((post) => ({
    kind: 'active',
    slug: post.id,
    title: post.data.title,
    dest: getPostPath(post),
  }));

  const deleted: RedirectEntry[] = DELETED_POST_REDIRECTS.map((d) => ({
    kind: 'deleted',
    slug: d.oldId,
    title: d.title ?? d.oldId,
    dest: d.newSlug ? `/${d.newSlug}` : '/',
  }));

  const all = [...active, ...deleted];

  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { props: { entry: RedirectEntry } }['props'];
const newUrl = entry.dest;
const pageTitle = entry.title;
const isDeleted = entry.kind === 'deleted';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle} · 已永久移动</title>
    <link rel="canonical" href={newUrl} />
    <meta name="robots" content={isDeleted ? 'noindex,nofollow' : 'noindex,follow'} />
    <meta http-equiv="refresh" content={`0; url=${newUrl}`} />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        max-width: 40rem;
        margin: 4rem auto;
        padding: 0 1.5rem;
        color: #222;
        line-height: 1.6;
      }
      a { color: #1e6fff; }
      .muted { opacity: 0.8; font-size: 0.95rem; }
    </style>
  </head>
  <body>
    <h1>{isDeleted ? '此内容已移除' : '此页面已永久移动'}</h1>
    {isDeleted ? (
      <p class="muted">
        原文《{pageTitle}》已不再发布。如浏览器未自动跳转，请点击下方链接返回首页。
      </p>
    ) : (
      <p>
        文章《{pageTitle}》的新地址：
        <a href={newUrl}>{newUrl}</a>
      </p>
    )}
    <p>
      <a href={newUrl}>
        {isDeleted ? '前往首页 →' : '如果浏览器没有自动跳转，请点击此链接 →'}
      </a>
    </p>
  </body>
</html>
